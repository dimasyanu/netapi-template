{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SmtpSettings": {
    "Host": "smtp.example.com",
    "Port": 25,
    "Username": "your_username",
    "Password": "your_password",
    "EnableSsl": true,
    "From": "admin@example.com"
  },
  "Jwt": {
    "Issuer": "YourIssuer",
    "Audience": "YourAudience",
    "SecretKey": "YourSuperSecretKey12345",
    "RefreshTokenValidityInDays": 5
  }
}